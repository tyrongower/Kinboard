# Kinboard stack variables.
# Dockhand: set these as stack variables (JWT_SECRET as a *secret*, not a plain variable).
# Plain docker compose: copy to .env next to docker-compose.yml, then chmod 600 .env

# REQUIRED. Signing key for JWT access tokens. Generate with: openssl rand -base64 48
# Keep the value stable across hosts/redeploys.
JWT_SECRET=

# REQUIRED. Exact scheme://host:port that browsers/kiosks use to reach Kinboard.
# Must match precisely - CORS is origin-exact and credentialed. No trailing slash.
KINBOARD_ORIGIN=http://192.168.1.50:6565

# Optional
KINBOARD_PORT=6565
TZ=Australia/Sydney
KINBOARD_IMAGE=tyrongower/kinboard
KINBOARD_TAG=latest
KINBOARD_CONTAINER_NAME=kinboard
